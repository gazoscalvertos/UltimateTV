<?xml version="1.0" encoding="utf-8"?>
<!--
  The Fire TV build's extra manifest bits (#183). The merged manifest is this over src/main.

  Three things a TV needs that a phone does not:
    - a LEANBACK_LAUNCHER entry, which is what puts the app on a Fire TV's home row beside the
      other apps. Android only shows an app on a TV launcher if one of its activities says this;
      MAIN/LAUNCHER alone is invisible there.
    - a banner (320x180), because a TV launcher shows a wide picture instead of a square icon.
      Generated by tools/android/make-banner.mjs, checked by hub/test/firetv.test.ts.
    - the two uses-feature lines below. Neither is about the TV build working: they say the app
      does not *need* a touchscreen or the leanback library, which stops Android from filtering it
      off a TV in the first place.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <application android:banner="@drawable/banner">
        <activity android:name=".ui.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
