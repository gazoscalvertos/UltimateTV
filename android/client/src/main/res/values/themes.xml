<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose draws everything; this only sets the dark window behind it while it starts. -->
    <style name="Theme.UltimateTV" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">#FF070B14</item>
        <item name="android:navigationBarColor">#FF070B14</item>
    </style>
    <style name="Theme.UltimateTV.Player" parent="android:Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@android:color/black</item>
    </style>
</resources>
