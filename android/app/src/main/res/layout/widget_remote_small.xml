<?xml version="1.0" encoding="utf-8"?>
<!-- The short widget (a 2x1-ish strip): still play/pause, Back and Home, plus the title. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#CC0B1220"
    android:padding="8dp">

    <TextView
        android:id="@+id/widget_now"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:maxLines="1"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:text="TV remote" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="3">

        <TextView
            android:id="@+id/widget_play"
            style="@style/WidgetKey"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="Pause" />

        <TextView
            android:id="@+id/widget_back"
            style="@style/WidgetKey"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="Back" />

        <TextView
            android:id="@+id/widget_home"
            style="@style/WidgetKey"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="Home" />
    </LinearLayout>
</LinearLayout>
