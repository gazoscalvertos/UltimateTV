[Unit]
Description=Pulse-Eight USB-CEC adapter on %I
BindsTo=dev-%i.device
After=dev-%i.device

[Service]
Type=simple
ExecStart=inputattach --pulse8-cec /dev/%I
# The udev rule can miss the remote's arrival, so load our button list here too.
ExecStartPost=-/usr/local/bin/ultimatetv-cec-keymap
Restart=on-failure
