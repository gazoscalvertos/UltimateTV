# The PXE server's own address on the LAN (the Docker LXC), and the port for its web server.
PXE_IP=192.168.0.19
PXE_HTTP_PORT=8097

# Only these machines see the reinstall menu (comma separated MAC addresses). Anything else that
# network-boots is sent straight back to its own disk. A machine shows its MAC when it netboots.
BOX_MAC=

# The installed box.
HUB_URL=http://192.168.0.19:8095
BRANCH=main
# Only if the GitHub repository is private: a fine-grained token with read-only Contents access
# to it. The box keeps it for its weekly updates. Anyone on the LAN can read it from this
# server while it runs, so stop the server when the install is done.
GITHUB_TOKEN=
BOX_HOSTNAME=ultimatetv
TIMEZONE=Europe/London
KEYMAP=uk
LOCALE=en_GB.UTF-8
# Your admin login on the box (for SSH and sudo). Make the hash with:  openssl passwd -6
ADMIN_USER=gary
ADMIN_PASSWORD_HASH=
# Optional: an SSH public key for the admin login.
ADMIN_SSH_KEY=
# Optional: the disk to install to (default: the biggest internal disk), e.g. /dev/nvme0n1
TARGET_DISK=
# The Arch mirror the installer boots from and installs packages from.
ARCH_MIRROR=https://geo.mirror.pkgbuild.com
