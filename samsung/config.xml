<?xml version="1.0" encoding="UTF-8"?>
<!-- UltimateTV for Samsung TVs (Tizen 4.0 and newer). docs/samsung.md explains how to put it on a TV. -->
<widget xmlns="http://www.w3.org/ns/widgets" xmlns:tizen="http://tizen.org/ns/widgets" id="http://ultimatetv.home/UltimateTV" version="0.1.0" viewmodes="maximized">
  <tizen:application id="UltimTV001.UltimateTV" package="UltimTV001" required_version="4.0"/>
  <content src="index.html"/>
  <feature name="http://tizen.org/feature/screen.size.all"/>
  <icon src="icon.png"/>
  <name>UltimateTV</name>
  <!-- Remote keys beyond the arrows (play, pause, colours), the picture and sound player, the network. -->
  <tizen:privilege name="http://tizen.org/privilege/tv.inputdevice"/>
  <tizen:privilege name="http://tizen.org/privilege/internet"/>
  <tizen:privilege name="http://tizen.org/privilege/display"/>
  <tizen:privilege name="http://developer.samsung.com/privilege/avplay"/>
  <tizen:privilege name="http://developer.samsung.com/privilege/productinfo"/>
  <tizen:profile name="tv-samsung"/>
  <!-- The Hub is on the home network and does not send CORS headers: this lets the app talk to it. -->
  <access origin="*" subdomains="true"/>
  <tizen:setting screen-orientation="landscape" context-menu="disable" background-support="disable" encryption="disable" install-location="auto" hwkey-event="enable"/>
</widget>
