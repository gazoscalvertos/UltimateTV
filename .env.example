# Copy to .env and adjust for your server.
HUB_PORT=8080
TZ=Europe/London
# Folder (inside the Docker LXC) for Phase 0 test clips. Defaults to ./test-clips next to this file.
CLIPS_HOST_DIR=./test-clips
# Group id that owns /dev/dri/renderD128 inside the Docker LXC (ls -ln /dev/dri).
RENDER_GID=104
